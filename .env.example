# Scopewatch Environment Variables
# Copy this file to .env and update the values as needed

# Django settings
DJANGO_SECRET_KEY=replace_this_with_a_real_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings (SQLite by default)
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3  # Path is auto-calculated relative to BASE_DIR

# Admin user for initial setup (optional)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin_password
# ADMIN_EMAIL=admin@example.com

# Other settings
# ADDITIONAL_HOSTS=example.com,www.example.com

# Email configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# Security settings for production
# Uncomment in production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
