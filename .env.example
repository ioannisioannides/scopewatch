# Scopewatch Environment Variables
# Copy this file to .env and update the values as needed

# Django settings
# Use a strong secret key in production
DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DEBUG=True

# Add comma-separated list of allowed hosts (in addition to localhost, 127.0.0.1)
ADDITIONAL_HOSTS=

# Database settings
# Uncomment and modify for PostgreSQL in production
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=scopewatch
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# Email configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# Security settings for production
# Uncomment in production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True